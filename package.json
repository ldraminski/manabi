{
  "name": "manabi",
  "private": true,
  "type": "module",
  "description": "Interview prep PWA: paste a job offer, take a short test, get a study plan.",
  "scripts": {
    "dev": "vite",
    "build": "npm run questions:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "questions:build": "node scripts/questions.mjs --write",
    "questions:check": "node scripts/questions.mjs --check"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
